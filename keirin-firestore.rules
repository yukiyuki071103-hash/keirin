rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function keirinName(n) {
      return n is string && n.size() >= 1 && n.size() <= 12;
    }
    function keirinScore(uid, date) {
      let d = request.resource.data;
      return request.auth != null && request.auth.uid == uid
        && date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && d.keys().hasOnly(['name', 'money', 'at'])
        && keirinName(d.name)
        && d.money is int && d.money >= 0 && d.money <= 100000000
        && d.at == request.time;
    }

    // ニックネーム：誰でも読める／本人だけが書ける
    match /keirin_players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && keirinName(request.resource.data.name);
    }

    // 1日モードのスコア：日付ごとに1人1件。自己ベストを超えたときだけ上書きできる
    match /keirin_days/{date}/scores/{uid} {
      allow read: if true;
      allow create: if keirinScore(uid, date);
      allow update: if keirinScore(uid, date) && request.resource.data.money > resource.data.money;
      allow delete: if false;
    }
  }
}
